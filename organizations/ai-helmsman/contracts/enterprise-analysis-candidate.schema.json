{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/enterprise-analysis-candidate.schema.json",
  "title": "企业分析候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "enterpriseId",
    "version",
    "enterpriseSnapshot",
    "evidenceLedger",
    "unknowns",
    "externalContext",
    "internalCapabilities",
    "metricBaseline",
    "issueTree",
    "strengths",
    "constraints",
    "opportunities",
    "risks",
    "coreProblems",
    "downstreamBrief",
    "decisionsRequired",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string" },
    "enterpriseId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "enterpriseSnapshot": { "type": "object" },
    "evidenceLedger": { "type": "array", "minItems": 3 },
    "unknowns": { "type": "array", "minItems": 1 },
    "externalContext": { "type": "array", "minItems": 1 },
    "internalCapabilities": { "type": "array", "minItems": 1 },
    "metricBaseline": { "type": "array", "minItems": 1 },
    "issueTree": { "type": "array", "minItems": 1 },
    "strengths": { "type": "array", "minItems": 1 },
    "constraints": { "type": "array", "minItems": 1 },
    "opportunities": { "type": "array", "minItems": 1 },
    "risks": { "type": "array", "minItems": 1 },
    "coreProblems": { "type": "array", "minItems": 1 },
    "downstreamBrief": { "type": "object" },
    "decisionsRequired": { "type": "array", "minItems": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
