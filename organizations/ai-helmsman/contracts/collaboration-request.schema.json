    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": 1 },
    "primaryOrganization": { "const": "ai-helmsman" },
    "requestingOrganization": { "const": "ai-helmsman" },
    "recursionDepth": { "const": 1 },
    "status": { "const": "requested" }
  }
}
