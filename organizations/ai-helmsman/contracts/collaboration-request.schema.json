{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/collaboration-request.schema.json",
  "title": "AI掌舵官跨组织协作请求",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "contractVersion",
    "parentTaskId",
    "requestId",
    "enterpriseId",
