{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/organization-task.schema.json",
  "title": "AI掌舵官组织任务",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "taskId",
    "enterpriseId",
    "primaryOrganization",
    "capabilityId",
    "status",
    "knowledgeStatus",
    "candidateVersion",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{3}-[a-z0-9-]{3,80}$" },
    "enterpriseId": { "type": "string" },
    "primaryOrganization": { "const": "ai-helmsman" },
    "capabilityId": {
      "enum": [
        "enterprise-analysis",
        "strategy-planning",
        "business-model"
      ]
    },
    "status": { "type": "string" },
    "knowledgeStatus": { "enum": ["pending", "matched", "no_hit", "degraded"] },
    "candidateVersion": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 1 }
  }
}
