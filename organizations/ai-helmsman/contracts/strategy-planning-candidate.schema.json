{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/strategy-planning-candidate.schema.json",
  "title": "战略规划候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "taskId",
    "enterpriseId",
    "version",
    "status",
    "upstreamAnalysis",
    "evidenceLedger",
    "strategicQuestion",
    "strategicOptions",
    "priorityOrder",
    "recommendation",
    "enterpriseDirection",
    "developmentPath",
    "resourceAllocation",
    "choices",
    "phaseGoals",
    "resourcePrinciples",
    "assumptions",
    "risks",
    "metrics",
    "milestones",
    "ninetyDayPlan",
    "downstreamBrief",
    "decisionsRequired",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "strategy-planning" },
    "taskId": { "type": "string" },
    "enterpriseId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "const": "candidate" },
    "upstreamAnalysis": { "type": "object" },
    "evidenceLedger": { "type": "array", "minItems": 2 },
    "strategicQuestion": { "type": "string", "minLength": 2 },
    "strategicOptions": { "type": "array", "minItems": 2 },
    "priorityOrder": { "type": "array", "minItems": 2 },
    "recommendation": { "type": "object" },
    "enterpriseDirection": { "type": "object" },
    "developmentPath": { "type": "array", "minItems": 1 },
    "resourceAllocation": { "type": "array", "minItems": 1 },
    "choices": { "type": "object" },
    "phaseGoals": { "type": "array", "minItems": 1 },
    "resourcePrinciples": { "type": "array", "minItems": 1 },
    "assumptions": { "type": "array", "minItems": 1 },
    "risks": { "type": "array", "minItems": 1 },
    "metrics": { "type": "array", "minItems": 1 },
    "milestones": { "type": "array", "minItems": 1 },
    "ninetyDayPlan": { "type": "array", "minItems": 1 },
    "downstreamBrief": { "type": "object" },
    "decisionsRequired": { "type": "array", "minItems": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
