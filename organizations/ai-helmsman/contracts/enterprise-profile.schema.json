{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/enterprise-profile.schema.json",
  "title": "AI掌舵官企业战略档案",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "enterpriseId",
    "displayName",
    "region",
    "timezone",
    "authorization",
    "strategySummary",
    "sensitive",
    "facts",
    "unknowns",
    "version",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enterpriseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "region": { "type": "object" },
    "timezone": { "type": "string", "minLength": 1 },
    "authorization": {
      "type": "object",
      "required": ["grantedBy", "grantedAt", "allowedScopes", "deniedScopes"]
    },
    "strategySummary": { "type": "object" },
    "sensitive": { "type": "object" },
    "facts": { "type": "array" },
    "unknowns": { "type": "array" },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
