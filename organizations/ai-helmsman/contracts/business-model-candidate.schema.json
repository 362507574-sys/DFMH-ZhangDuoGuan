{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-helmsman/business-model-candidate.schema.json",
  "title": "商业模式候选",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "taskId",
    "enterpriseId",
    "version",
    "status",
    "upstreamAnalysis",
    "upstreamStrategy",
    "evidenceLedger",
    "customerArchitecture",
    "valuePropositions",
    "offerArchitecture",
    "productStructure",
    "profitModel",
    "revenueModel",
    "costModel",
    "unitEconomics",
    "customerJourney",
    "customerValueChain",
    "keyResources",
    "partners",
    "businessAssumptions",
    "experiments",
    "growthModel",
    "risks",
    "unknowns",
    "decisionsRequired",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "const": "business-model" },
    "taskId": { "type": "string" },
    "enterpriseId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "const": "candidate" },
    "upstreamAnalysis": { "type": "object" },
    "upstreamStrategy": { "type": "object" },
    "evidenceLedger": { "type": "array", "minItems": 2 },
    "customerArchitecture": { "type": "object" },
    "valuePropositions": { "type": "array", "minItems": 1 },
    "offerArchitecture": { "type": "array", "minItems": 1 },
    "productStructure": { "type": "array", "minItems": 1 },
    "profitModel": { "type": "object" },
    "revenueModel": { "type": "array", "minItems": 1 },
    "costModel": { "type": "array", "minItems": 1 },
    "unitEconomics": { "type": "object" },
    "customerJourney": { "type": "object" },
    "customerValueChain": { "type": "array", "minItems": 6 },
    "keyResources": { "type": "array", "minItems": 1 },
    "partners": { "type": "array", "minItems": 1 },
    "businessAssumptions": { "type": "array", "minItems": 1 },
    "experiments": { "type": "array", "minItems": 1 },
    "growthModel": { "type": "object" },
    "risks": { "type": "array", "minItems": 1 },
    "unknowns": { "type": "array", "minItems": 1 },
    "decisionsRequired": { "type": "array", "minItems": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
